# Copy to .env.local and fill in values.
# Edge Function secrets (send-push) are set separately via `supabase secrets set`
# — see README. Auto-injected there: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.

# --- Public (Next.js / browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Server (Next.js) ---
# Shared secret for authorizing calls to the send-push edge function.
CRON_SECRET=your-cron-secret

# --- Supabase (local tooling) ---
# Used by scripts/seed-demo-events.mjs; not required to run the Next.js app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Push / VAPID ---
# Generate with: npx web-push generate-vapid-keys
# Also set as edge secrets: VAPID_PUBLIC_KEY (same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY),
# VAPID_PRIVATE_KEY, VAPID_SUBJECT, CRON_SECRET, SITE_URL.
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
